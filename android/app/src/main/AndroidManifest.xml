<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The phone's contacts: read and edit them, only after the user allows it. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- Modo MCP through the relay, only when the user turns it on (off by default). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <permission android:name="com.zirakusa.gatewayhub.permission.LINK" android:protectionLevel="signature"
        android:label="@string/hub_link_permission" />
    <permission android:name="com.zirakusa.family.permission.SUMMARY" android:protectionLevel="signature"
        android:label="@string/summary_permission" />
    <queries>
        <package android:name="com.zirakusa.gatewayhub" />
        <intent><action android:name="android.intent.action.DIAL" /></intent>
        <intent><action android:name="android.intent.action.SENDTO" /><data android:scheme="smsto" /></intent>
        <intent><action android:name="android.intent.action.SENDTO" /><data android:scheme="mailto" /></intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Gateway Hub's scanner finds Contactos (module contacts_) and its link channel. Being found turns nothing on. -->
            <intent-filter>
                <action android:name="com.zirakusa.gatewayhub.action.APP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="com.zirakusa.gatewayhub.module" android:value="contacts_" />
            <meta-data android:name="com.zirakusa.gatewayhub.link" android:value="${applicationId}.hublink" />
            <meta-data android:name="com.zirakusa.family.summary" android:value="${applicationId}.summary" />
        </activity>
        <!-- «Compartir»: the contact's .vcf from the app's cache, read only by the app the user picks. -->
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.files"
            android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
        <provider android:name=".SummaryProvider" android:authorities="${applicationId}.summary"
            android:exported="true" android:permission="com.zirakusa.family.permission.SUMMARY" />
        <provider android:name=".mcp.HubLinkProvider" android:authorities="${applicationId}.hublink"
            android:exported="true" android:permission="com.zirakusa.gatewayhub.permission.LINK" />
    </application>
</manifest>
