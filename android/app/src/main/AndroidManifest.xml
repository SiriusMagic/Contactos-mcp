<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Only to download catalog.json and the family's APKs from raw.githubusercontent.com (https). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only to know whether the network is Wi‑Fi (Ajustes › «Solo con Wi‑Fi»). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Installs and updates the family's apps with PackageInstaller («Instalar apps desconocidas» must be allowed). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+: updates of apps Tienda installed may skip the extra confirmation (Android can still ask). -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <queries>
        <!-- No QUERY_ALL_PACKAGES: Tienda sees only apps with a launcher entry (every family app has one). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- PackageInstaller's answers (installed, failed, needs the user to confirm). Only our own PendingIntent. -->
        <receiver android:name=".InstallReceiver" android:exported="false" />
    </application>
</manifest>
